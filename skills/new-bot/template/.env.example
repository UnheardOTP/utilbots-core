# This bot's own values. On the server: /mnt/user/appdata/__SLUG__/.env (POSTGRES_PASSWORD, SESSION_SECRET,
# PUBLIC_URL and WEB_PORT are generated by the first deploy). Shared values (Stripe, ADMIN_IDS...) live in
# /mnt/user/appdata/utilbots-shared/.env — see utilbots-core/STANDARD.md.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
PUBLIC_URL=http://localhost:8080
SESSION_SECRET=change-me
# Locally you can set these here instead of the shared file:
ADMIN_IDS=
STRIPE_SECRET_KEY=
